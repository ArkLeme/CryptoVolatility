VAGRANTFILE_API_VERSION = "2"

NODES = {
  "namenode"  => "192.168.56.10",
  "datanode1" => "192.168.56.11"
}

Vagrant.configure(VAGRANTFILE_API_VERSION) do |config|
  config.vm.box = "ubuntu/bionic64"
  
  # VirtualBox configuration
  config.vm.provider "virtualbox" do |vb|
    vb.memory = 1024
    vb.cpus = 1
  end

  # All nodes configuration
  NODES.each do |name, ip|
    config.vm.define name do |node|
      node.vm.hostname = name
      node.vm.network "private_network", ip: ip
      
      # Set hostname
      node.vm.provision "shell", inline: <<-SHELL
        echo "#{name}" | sudo tee /etc/hostname
        sudo hostname #{name}
      SHELL
      
      # Base bootstrapping script
      node.vm.provision "shell", path: "bootstrap/base.sh"
      
      # Node-specific bootstrapping
      if name == "namenode"
        node.vm.provision "shell", path: "bootstrap/namenode.sh"
      else
        node.vm.provision "shell", path: "bootstrap/datanode.sh"
      end

      # Use Vagrant's built-in SSH key management
      node.ssh.insert_key = true
    end
  end
end
